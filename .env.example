# ============================================================
#  JobHunterHub - configuracion local
#  Copiar este archivo a .env y completar lo que se necesite.
#  NINGUNA credencial debe subirse a Git ni exponerse al frontend.
# ============================================================

# --- Servidor ---
PORT=4100
HOST=127.0.0.1
NODE_ENV=production

# --- Seguridad ---
# Clave para firmar los tokens de sesion (JWT HS256).
# Si se deja vacia se genera una al instalar y se guarda en data/secret.key
JWT_SECRET=
# Clave maestra para cifrar credenciales de conectores (AES-256-GCM).
# Si se deja vacia se deriva de JWT_SECRET.
CREDENTIALS_KEY=
# Duracion de la sesion en horas
SESSION_HOURS=12

# --- Usuario administrador inicial (solo se usa en el primer arranque) ---
ADMIN_EMAIL=admin@jobhunter.local
ADMIN_PASSWORD=admin1234

# --- Proveedor de IA ---
# Valores: heuristic | anthropic | openai | ollama
# "heuristic" funciona sin API key (analisis deterministico local).
AI_PROVIDER=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# --- Conectores que requieren credenciales ---
# Adzuna: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Greenhouse (envio de candidaturas, Basic Auth)
GREENHOUSE_API_KEY=

# Lever (envio de candidaturas)
LEVER_API_KEY=

# SmartRecruiters (OAuth 2.0)
SMARTRECRUITERS_CLIENT_ID=
SMARTRECRUITERS_CLIENT_SECRET=

# Upwork (OAuth 2.0)
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=

# Freelancer
FREELANCER_OAUTH_TOKEN=

# --- Sincronizacion automatica ---
# Minutos entre ejecuciones del worker de sincronizacion (0 = desactivado)
SYNC_INTERVAL_MINUTES=60
